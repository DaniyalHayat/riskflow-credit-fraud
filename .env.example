# Default: zero-install SQLite. Copy this file to .env only when using integrations.
DB_BACKEND=sqlite
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=riskflow
MYSQL_PASSWORD=local-demo-change-me
MYSQL_DATABASE=riskflow
MYSQL_ROOT_PASSWORD=local-root-change-me
# Optional OpenAI. Select a model available in YOUR account that supports Structured Outputs.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional local Ollama model installed on your computer.
OLLAMA_MODEL=llama3.2
